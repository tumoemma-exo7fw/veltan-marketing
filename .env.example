# Copy to .env.local. Never commit real keys.

# Supabase project (Authentication → URL and anon/publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same value on marketing and veltan-app so ?sso= JWTs verify
VELTAN_SSO_SECRET=

# Product app
NEXT_PUBLIC_FOLLOWUP_APP_URL=https://veltan-app.vercel.app/
